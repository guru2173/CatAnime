{
  "name": "cat-anime",
  "version": "1.0.0",
  "private": true,
  "description": "CatAnime: 2.5D zero-dialogue cat anime engine + episodes (Remotion + three.js)",
  "type": "module",
  "scripts": {
    "studio": "remotion studio",
    "sfx": "node scripts/generate-sfx.mjs",
    "typecheck": "tsc --noEmit",
    "stills": "node scripts/render-stills.mjs",
    "render:ep01": "remotion render Ep01TheLastSeat out/ep01-the-last-seat.mp4 --gl=angle --concurrency=4",
    "new-episode": "node scripts/new-episode.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "9.3.0",
    "@remotion/cli": "4.0.545",
    "@remotion/media-utils": "4.0.545",
    "@remotion/three": "4.0.545",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.545",
    "three": "0.178.0"
  },
  "devDependencies": {
    "@types/react": "19.1.8",
    "@types/three": "0.178.1",
    "typescript": "5.8.3"
  }
}
